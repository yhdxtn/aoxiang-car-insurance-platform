[Unit]
Description=Taikang quote-only private gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taikang
Group=taikang
WorkingDirectory=/opt/taikang-mini/services/taikang-gateway
EnvironmentFile=/etc/taikang-mini.env
Environment=PYTHONPATH=/opt/taikang-mini/services/taikang-gateway/src
Environment=TZ=UTC
ExecStart=/opt/taikang-mini/services/taikang-gateway/.venv/bin/uvicorn tk_gateway.app:create_app --factory --host 127.0.0.1 --port 18081 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
