page {
  background: #fff8ee;
  color: #252b31;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
  --orange: #ff7526;
  --soft: #fff0de;
  --muted: #92979e;
}
view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button {
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  line-height: 1.5;
  margin: 0;
  padding: 23rpx 25rpx;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.46;
}
.btn-primary {
  background: linear-gradient(115deg, #ff8b3f, #ff6e21);
  color: #fff;
}
.btn-secondary {
  background: #fff;
  color: #ff7526;
  border: 2rpx solid #ffd6b8;
}
.btn-plain {
  background: #fff;
  color: #30343a;
  border: 2rpx solid #e9e9e8;
}
.btn-small {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
}
.text-link {
  color: #eb752d;
}
.muted {
  color: #8d939b;
}
.small {
  font-size: 23rpx;
}
.page {
  padding: 32rpx 28rpx 50rpx;
}
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
}
.heading {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #b4835d;
}
.section-title {
  font-size: 30rpx;
  font-weight: 650;
  margin: 32rpx 0 18rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.tag {
  display: inline-block;
  padding: 4rpx 13rpx;
  border-radius: 10rpx;
  background: #fff0de;
  color: #c3843c;
  font-size: 21rpx;
}
.demo-banner {
  background: #fff0cf;
  color: #946718;
  text-align: center;
  font-size: 22rpx;
  padding: 9rpx 18rpx;
}
.error-box {
  background: #fff0ed;
  color: #bd4c36;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  margin: 18rpx 0;
  word-break: break-all;
}
.empty {
  padding: 70rpx 32rpx;
  text-align: center;
  color: #969ca3;
}
.empty-title {
  color: #56606b;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}
.loading {
  padding: 40rpx;
  text-align: center;
  color: #a28c74;
}
.field {
  margin-bottom: 22rpx;
}
.field-label {
  font-size: 24rpx;
  color: #66717e;
  margin-bottom: 9rpx;
}
.field-input {
  background: #f8f9fa;
  border: 2rpx solid #edf0f2;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  width: 100%;
  height: 84rpx;
  font-size: 28rpx;
  color: #252b31;
}
.textarea {
  height: 160rpx;
}
.divider {
  height: 2rpx;
  background: #f0f1f3;
  margin: 23rpx 0;
}
.key-value {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}
.key-value:last-child {
  border-bottom: 0;
}
.key-value .key {
  width: 145rpx;
  flex-shrink: 0;
  color: #8d949d;
}
.key-value .value {
  flex: 1;
  word-break: break-all;
}
.status-pill {
  font-size: 22rpx;
  padding: 5rpx 14rpx;
  background: #fff1e1;
  color: #c87932;
  border-radius: 12rpx;
}
.money {
  color: #ef7021;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
.spacer {
  height: 24rpx;
}
.notice {
  font-size: 23rpx;
  color: #9b8771;
  line-height: 1.8;
}
.toolbar {
  display: flex;
  gap: 18rpx;
}
.toolbar button {
  flex: 1;
}
.toast-line {
  background: #eef8f3;
  color: #3f8163;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 23rpx;
  margin: 16rpx 0;
}
