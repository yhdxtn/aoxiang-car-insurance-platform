.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx 6rpx 38rpx;
}
.profile-avatar {
  background: #fff;
  border-radius: 50%;
  padding: 12rpx;
}
.profile-name {
  font-size: 35rpx;
  font-weight: 700;
}
.profile-subtitle {
  font-size: 24rpx;
  color: #aa8d74;
  margin-top: 7rpx;
}
.profile-org {
  font-size: 21rpx;
  color: #b6a18c;
  margin-top: 5rpx;
}
.points-card {
  background: linear-gradient(115deg, #ff9b50, #f6752d);
  border-radius: 28rpx;
  color: #fff;
  padding: 30rpx 35rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.points-label {
  font-size: 23rpx;
  color: #ffedda;
}
.points-value {
  font-size: 59rpx;
  font-weight: 700;
  line-height: 1.4;
}
.points-link {
  font-size: 24rpx;
}
.menu-group {
  background: #fff;
  border-radius: 26rpx;
  padding: 0 26rpx;
  margin-bottom: 23rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f4f0ea;
  font-size: 28rpx;
}
.menu-item:last-child {
  border-bottom: 0;
}
.menu-symbol {
  width: 43rpx;
  height: 43rpx;
  color: #d79963;
  text-align: center;
  line-height: 41rpx;
  border-radius: 12rpx;
  background: #fff5e8;
  font-size: 29rpx;
}
.chevron {
  font-size: 35rpx;
  color: #c7bcb1;
}
.logout-link {
  color: #a79585;
  text-align: center;
  font-size: 26rpx;
  padding: 20rpx;
}
.profile-footer {
  text-align: center;
  font-size: 22rpx;
  color: #beac99;
  margin: 25rpx 0;
}
.password-panel {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  background: #2d28215c;
  padding: 35rpx;
  z-index: 50;
}
.password-panel > .card {
  width: 100%;
  padding: 35rpx;
}
.password-panel .heading {
  margin-bottom: 25rpx;
}
