<view wx:if="{{mode === 'demo'}}" class="demo-banner">
  演示环境 · 不产生真实保单与支付
</view>
<view class="assistant-page">
  <view class="steps-card">
    <view class="steps">
      <view class="step {{stage >= 1 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text>资料确认</text>
      </view>
      <view class="step-line {{stage >= 2 ? 'active-line' : ''}}"></view>
      <view class="step {{stage >= 2 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text>方案报价</text>
      </view>
      <view class="step-line {{stage >= 3 ? 'active-line' : ''}}"></view>
      <view class="step {{stage >= 3 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text>投保确认</text>
      </view>
    </view>
    <view class="handling">
      正在办理：{{vehicleTypeLabel}}投保
      <text class="handling-insurer">泰康</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="loading">正在为你准备服务…</view>
  <view wx:if="{{!loading && !session}}" class="empty">
    <view class="empty-title">暂时无法进入服务</view>
    <view>{{error || '请登录后继续'}}</view>
    <button class="btn-secondary" bindtap="initialize">重新进入</button>
  </view>
  <block wx:if="{{session}}">
    <view class="service-bar">
      <text class="service-status">
        <text class="online-dot"></text>
        {{sessionStatus}}
      </text>
      <view
        class="text-link"
        bindtap="handoff"
        wx:if="{{session.status === 'BOT'}}"
      >
        转人工客服
      </view>
      <view class="text-link" bindtap="refresh">刷新</view>
    </view>
    <view class="chat-row assistant-message">
      <assistant-avatar />
      <view class="bubble assistant-bubble">{{greeting}}</view>
    </view>
    <view wx:if="{{canSend}}" class="intro-actions">
      <button
        class="btn-secondary upload-button"
        bindtap="addAttachment"
        disabled="{{uploading || busy}}"
      >
        <text class="button-icon">↥</text>
        上传资料
      </button>
      <button
        class="btn-plain"
        bindtap="openForm"
        disabled="{{busy || session.orderId}}"
      >
        <text class="button-icon">▤</text>
        手动填写
      </button>
    </view>
    <view wx:if="{{uploading}}" class="upload-status">
      <text>资料上传中 {{uploadProgress}}%</text>
      <progress
        percent="{{uploadProgress}}"
        stroke-width="3"
        activeColor="#ff7929"
        backgroundColor="#fff0dc"
      />
    </view>
    <view wx:if="{{busy && !uploading}}" class="loading">
      正在处理，请稍候…
    </view>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="chat-row {{item.user ? 'user-message' : 'assistant-message'}}"
    >
      <assistant-avatar wx:if="{{!item.user}}" service="{{item.service}}" />
      <view class="bubble {{item.user ? 'user-bubble' : 'assistant-bubble'}}">
        <view wx:if="{{item.service}}" class="sender-name">人工客服</view>
        <view class="message-text">{{item.content}}</view>
        <view
          wx:if="{{item.fileId}}"
          class="file-preview"
          data-id="{{item.fileId}}"
          data-path="{{item.imagePath}}"
          bindtap="preview"
        >
          <image
            wx:if="{{item.imagePath}}"
            src="{{item.imagePath}}"
            mode="aspectFit"
            class="document-image"
          />
          <view wx:else class="document-placeholder">
            <text>▤</text>
            <view>点击查看资料</view>
          </view>
          <view class="file-name">{{item.fileName || '资料图片'}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{error}}" class="error-box">{{error}}</view>
    <view wx:if="{{pollPaused}}" class="poll-tip" bindtap="continuePolling">
      消息自动接收已暂停，点击继续接收
    </view>
    <view wx:if="{{hasVehicle}}" class="flow-card vehicle-card">
      <view class="card-title-row">
        <view class="flow-title">车辆信息</view>
        <text class="tag">请核对</text>
      </view>
      <view class="key-value">
        <text class="key">车牌号</text>
        <text class="value">{{vehicleSummary.plateNo || '新车未上牌'}}</text>
      </view>
      <view class="key-value">
        <text class="key">车辆类型</text>
        <text class="value">{{vehicleTypeLabel}}</text>
      </view>
      <view class="key-value">
        <text class="key">使用性质</text>
        <text class="value">{{vehicleSummary.useNature || '待确认'}}</text>
      </view>
      <view class="key-value">
        <text class="key">车主姓名</text>
        <text class="value">{{vehicleSummary.ownerName || '待补充'}}</text>
      </view>
      <view wx:if="{{vehicleSummary.vin}}" class="key-value">
        <text class="key">车架号</text>
        <text class="value">{{vehicleSummary.vin}}</text>
      </view>
      <view
        class="toolbar card-actions"
        wx:if="{{!session.orderId && canSend}}"
      >
        <button class="btn-secondary" bindtap="openForm">修改信息</button>
        <button
          wx:if="{{!isManualVehicle}}"
          class="btn-primary"
          bindtap="confirmVehicle"
        >
          确认并继续
        </button>
        <button wx:else class="btn-primary" bindtap="handoff">
          交给人工客服
        </button>
      </view>
    </view>
    <view wx:if="{{isManualVehicle}}" class="manual-card">
      <view class="manual-icon">♡</view>
      <view class="flow-title">{{vehicleTypeLabel}} · 人工专属服务</view>
      <view class="muted small">
        已进入人工服务流程。资料准备好后，可以在下方留言，客服会在本会话中回复。
      </view>
    </view>
    <view
      wx:if="{{stage >= 2 && !isManualVehicle && !session.orderId}}"
      id="plan-card"
      class="flow-card"
    >
      <view class="card-title-row">
        <view class="flow-title">选择保障方案</view>
        <text class="tag">泰康车险</text>
      </view>
      <view class="muted small">先选方案与保额，再获取本次车辆报价。</view>
      <view class="plan-tabs">
        <view
          data-plan="COMPULSORY"
          bindtap="selectPlan"
          class="plan-tab {{plan === 'COMPULSORY' ? 'selected' : ''}}"
        >
          交强险
        </view>
        <view
          data-plan="STANDARD"
          bindtap="selectPlan"
          class="plan-tab {{plan === 'STANDARD' ? 'selected' : ''}}"
        >
          交强＋三者
        </view>
        <view
          data-plan="FULL"
          bindtap="selectPlan"
          class="plan-tab {{plan === 'FULL' ? 'selected' : ''}}"
        >
          全面保障
        </view>
      </view>
      <view class="plan-description">
        {{plan === 'COMPULSORY' ? '交强险及适用的车船税' : plan === 'STANDARD' ?
        '交强险、第三者责任险等保障，不含车损险' :
        '含车损险、交强险、第三者责任险等保障；可保项目以返回结果为准'}}
      </view>
      <view wx:if="{{plan !== 'COMPULSORY'}}" class="amount-grid">
        <view class="field">
          <view class="field-label">三者保额（万元）</view>
          <input
            class="field-input"
            type="digit"
            value="{{thirdPartyWan}}"
            data-field="thirdPartyWan"
            bindinput="amountInput"
            disabled="{{quoting || quoteUncertain}}"
          />
        </view>
        <view class="field">
          <view class="field-label">司机每座（万元）</view>
          <input
            class="field-input"
            type="digit"
            value="{{driverWan}}"
            data-field="driverWan"
            bindinput="amountInput"
            disabled="{{quoting || quoteUncertain}}"
          />
        </view>
        <view class="field">
          <view class="field-label">乘客每座（万元）</view>
          <input
            class="field-input"
            type="digit"
            value="{{passengerWan}}"
            data-field="passengerWan"
            bindinput="amountInput"
            disabled="{{quoting || quoteUncertain}}"
          />
        </view>
        <view class="field">
          <view class="field-label">医保外保额（万元）</view>
          <input
            class="field-input"
            type="digit"
            value="{{medicalWan}}"
            data-field="medicalWan"
            bindinput="amountInput"
            disabled="{{quoting || quoteUncertain}}"
          />
        </view>
      </view>
      <view wx:if="{{quoteError}}" class="error-box">{{quoteError}}</view>
      <view wx:if="{{quoteUncertain}}" class="uncertain-panel">
        <view>本次报价正在核查，请先查询结果。</view>
        <view class="toolbar">
          <button class="btn-secondary btn-small" bindtap="refresh">
            查询报价状态
          </button>
          <button class="btn-plain btn-small" bindtap="handoff">
            联系人工客服
          </button>
        </view>
      </view>
      <button
        wx:else
        class="btn-primary"
        bindtap="requestQuote"
        loading="{{quoting}}"
        disabled="{{quoting || busy || !hasVehicle}}"
      >
        {{quoting ? '正在获取报价…' : quote ? '按当前方案重新报价' :
        '获取泰康报价'}}
      </button>
    </view>
    <view wx:if="{{quote}}" class="flow-card quote-card">
      <view class="card-title-row">
        <view class="flow-title">泰康报价方案</view>
        <text wx:if="{{quote.demo}}" class="tag">演示</text>
        <text wx:else class="tag">{{quote.statusLabel}}</text>
      </view>
      <block wx:if="{{quote.status === 'QUOTED'}}">
        <view class="premium-row">
          <view>
            <text class="premium-sign">¥</text>
            <text class="premium-value">{{quote.formattedPremium}}</text>
          </view>
          <text class="muted small">保费合计</text>
        </view>
        <view class="quote-version">
          第 {{quote.revision || 1}} 版 · {{quote.formattedExpiry ?
          quote.formattedExpiry + ' 前有效' : '以最新报价为准'}}
        </view>
        <view wx:for="{{quote.coverages}}" wx:key="name" class="coverage-row">
          <view class="grow">
            <view>{{item.name}}</view>
            <view class="muted small" wx:if="{{item.amount}}">
              保障额度：{{item.amount}}
            </view>
          </view>
          <view class="coverage-premium">¥{{item.formattedPremium}}</view>
        </view>
        <view class="premium-breakdown">
          <view>
            商业险
            <text>¥{{quote.commercialPremium || '0.00'}}</text>
          </view>
          <view>
            交强险
            <text>¥{{quote.compulsoryPremium || '0.00'}}</text>
          </view>
          <view>
            车船税
            <text>¥{{quote.vehicleTax || '0.00'}}</text>
          </view>
        </view>
        <view wx:if="{{quote.demo}}" class="demo-note">
          当前为演示报价，不能作为真实承保金额。
        </view>
        <view wx:if="{{quote.expired}}" class="error-box">
          报价已过期，请重新获取报价。
        </view>
        <button
          wx:if="{{stage < 3 && !session.orderId}}"
          class="btn-primary"
          bindtap="chooseQuote"
          disabled="{{quoteUncertain || quote.expired}}"
        >
          选择方案，继续投保
        </button>
      </block>
      <view wx:else class="quote-failure">
        <view>{{quote.statusLabel}}</view>
        <view class="muted small">
          {{quote.message || '请联系人工客服协助核查本次车辆资料。'}}
        </view>
        <button class="btn-secondary" bindtap="handoff">联系人工客服</button>
      </view>
    </view>
    <view
      wx:if="{{stage === 3 && quote && quote.status === 'QUOTED' && !session.orderId}}"
      id="confirmation-card"
      class="flow-card"
    >
      <view class="flow-title">确认投保资料</view>
      <view class="key-value">
        <text class="key">车辆</text>
        <text class="value">{{vehicle.plateNo || vehicle.vin}}</text>
      </view>
      <view class="key-value">
        <text class="key">车主</text>
        <text class="value">{{vehicle.ownerName}}</text>
      </view>
      <view class="key-value">
        <text class="key">联系电话</text>
        <text class="value">{{vehicle.phone || '未填写，请修改资料补充'}}</text>
      </view>
      <view class="key-value">
        <text class="key">方案合计</text>
        <text class="value text-link">¥{{quote.formattedPremium}}</text>
      </view>
      <view class="notice confirmation-notice">
        提交后由客服核对承保资料。投保申请不代表已付款或已出单，最终承保以保险公司核保结果为准。
      </view>
      <button
        class="btn-primary"
        bindtap="submitOrder"
        disabled="{{submittingOrder || quoteUncertain || !vehicle.phone}}"
        loading="{{submittingOrder}}"
      >
        确认并提交申请
      </button>
      <view class="change-plan" bindtap="changePlan">返回调整方案</view>
    </view>
    <view wx:if="{{session.orderId}}" class="flow-card completed-card">
      <view class="success-mark">✓</view>
      <view class="flow-title">投保申请已提交</view>
      <view class="muted small">
        客服将核对资料并继续办理，可在订单中查看最新进度。
      </view>
      <button class="btn-primary" bindtap="viewOrder">查看申请进度</button>
    </view>
    <view wx:if="{{!canSend}}" class="notice closed-notice">
      本次会话已结束。历史资料可继续查看，需要办理新业务请返回首页。
    </view>
    <view class="conversation-end" id="conversation-end"></view>
  </block>
</view>
<view class="composer-wrap" wx:if="{{session}}">
  <view class="composer">
    <view
      class="composer-action plus-button {{uploading || !canSend ? 'composer-disabled' : ''}}"
      bindtap="addAttachment"
      aria-label="上传资料"
    >
      <text>＋</text>
    </view>
    <input
      class="chat-input"
      value="{{messageText}}"
      bindinput="messageInput"
      placeholder="输入信息，或上传照片"
      maxlength="2000"
      confirm-type="send"
      bindconfirm="sendMessage"
      disabled="{{!canSend}}"
      adjust-position
    />
    <view
      class="composer-action send-button {{!messageText || !canSend ? 'composer-disabled' : ''}}"
      bindtap="sendMessage"
      aria-label="发送消息"
    >
      <text>➤</text>
    </view>
  </view>
  <view class="composer-safe-bottom"></view>
</view>
<view
  wx:if="{{showUploadMenu}}"
  class="upload-menu-mask"
  bindtap="closeUploadMenu"
  catchtouchmove="noop"
>
  <view
    class="upload-menu-sheet"
    catchtap="noop"
    aria-role="dialog"
    aria-label="选择资料类型"
  >
    <view class="upload-menu-options">
      <button
        wx:for="{{uploadOptions}}"
        wx:key="value"
        class="upload-menu-item"
        data-type="{{item.value}}"
        bindtap="chooseUploadDocument"
        hover-class="upload-menu-pressed"
      >
        {{item.label}}
      </button>
    </view>
    <button
      class="upload-menu-item upload-menu-cancel"
      bindtap="closeUploadMenu"
      hover-class="upload-menu-pressed"
    >
      取消
    </button>
  </view>
</view>
<view wx:if="{{showForm}}" class="modal-mask" bindtap="closeForm">
  <view class="form-sheet" catchtap="noop">
    <view class="sheet-header">
      <view>
        <view class="flow-title">核对车辆资料</view>
        <view class="muted small">请按证件真实信息填写</view>
      </view>
      <text class="sheet-close" bindtap="closeForm">×</text>
    </view>
    <scroll-view class="form-scroll" scroll-y enhanced>
      <view class="form-inner">
        <view wx:if="{{formError}}" class="error-box">{{formError}}</view>
        <view class="field">
          <view class="field-label">车牌号（未上牌车辆请联系人工客服）</view>
          <input
            class="field-input"
            value="{{form.plateNo}}"
            data-field="plateNo"
            bindinput="formInput"
            placeholder="如：云A12345"
            maxlength="10"
          />
        </view>
        <view class="field">
          <view class="field-label">车架号 / VIN</view>
          <input
            class="field-input"
            value="{{form.vin}}"
            data-field="vin"
            bindinput="formInput"
            placeholder="17位车架号"
            maxlength="17"
          />
        </view>
        <view class="field">
          <view class="field-label">发动机号</view>
          <input
            class="field-input"
            value="{{form.engineNo}}"
            data-field="engineNo"
            bindinput="formInput"
            maxlength="40"
          />
        </view>
        <view class="field">
          <view class="field-label">品牌型号</view>
          <input
            class="field-input"
            value="{{form.brandModel}}"
            data-field="brandModel"
            bindinput="formInput"
            placeholder="按行驶证填写"
            maxlength="100"
          />
        </view>
        <view class="amount-grid">
          <view class="field">
            <view class="field-label">注册日期</view>
            <picker
              mode="date"
              value="{{form.registerDate}}"
              data-field="registerDate"
              bindchange="formInput"
            >
              <view class="field-input picker-input">
                {{form.registerDate || '请选择'}}
              </view>
            </picker>
          </view>
          <view class="field">
            <view class="field-label">发证日期</view>
            <picker
              mode="date"
              value="{{form.issueDate}}"
              data-field="issueDate"
              bindchange="formInput"
            >
              <view class="field-input picker-input">
                {{form.issueDate || '请选择'}}
              </view>
            </picker>
          </view>
        </view>
        <view class="field">
          <view class="field-label">使用性质</view>
          <picker range="{{useNatures}}" bindchange="chooseUse">
            <view class="field-input picker-input">
              {{form.useNature || '请选择使用性质'}}
            </view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">核定座位数（含驾驶员）</view>
          <input
            class="field-input"
            type="number"
            value="{{form.seatCount}}"
            data-field="seatCount"
            bindinput="formInput"
            maxlength="2"
          />
        </view>
        <view class="field">
          <view class="field-label">车主姓名</view>
          <input
            class="field-input"
            value="{{form.ownerName}}"
            data-field="ownerName"
            bindinput="formInput"
            maxlength="60"
          />
        </view>
        <view class="field">
          <view class="field-label">车主身份证号</view>
          <input
            class="field-input"
            value="{{form.idNumber}}"
            data-field="idNumber"
            bindinput="formInput"
            maxlength="18"
          />
        </view>
        <view class="field">
          <view class="field-label">证件详细地址</view>
          <textarea
            class="field-input textarea"
            value="{{form.address}}"
            data-field="address"
            bindinput="formInput"
            maxlength="200"
            placeholder="请按证件地址填写"
          />
        </view>
        <view class="field">
          <view class="field-label">联系人手机号</view>
          <input
            class="field-input"
            type="number"
            value="{{form.phone}}"
            data-field="phone"
            bindinput="formInput"
            maxlength="11"
          />
        </view>
        <view class="notice">
          所填信息仅用于报价与投保服务。图片识别可能存在误差，请仔细核对。
        </view>
        <view class="spacer"></view>
      </view>
    </scroll-view>
    <view class="sheet-footer">
      <button
        class="btn-primary"
        bindtap="saveVehicle"
        loading="{{busy}}"
        disabled="{{busy}}"
      >
        保存并核对
      </button>
      <view class="safe-bottom"></view>
    </view>
  </view>
</view>
<view wx:if="{{showPrivacy}}" class="privacy-mask">
  <view class="privacy-card">
    <view class="flow-title">资料使用授权</view>
    <view class="privacy-copy">
      上传行驶证、身份证及聊天图片用于车辆识别、报价和人工投保服务。请阅读本小程序的隐私保护指引。
    </view>
    <view class="text-link" bindtap="openPrivacyContract">
      查看《用户隐私保护指引》
    </view>
    <view class="toolbar">
      <button class="btn-plain" bindtap="rejectPrivacy">暂不同意</button>
      <button
        class="btn-primary"
        id="agree-privacy"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="acceptPrivacy"
      >
        同意并继续
      </button>
    </view>
  </view>
</view>
