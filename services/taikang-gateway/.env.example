# Generate separate random values; do not reuse the insurer password here.
TK_GATEWAY_TOKEN=
TK_LEDGER_KEY=
TK_LEDGER_PATH=./var/requests.sqlite3
TK_LIVE_ENABLED=false
TK_USERNAME=
TK_PASSWORD=
# Set all four to the actual carrier-authorized region. Original code used 云南/曲靖.
TK_PROVINCE_CODE=
TK_PROVINCE_NAME=
TK_CITY_CODE=
TK_CITY_NAME=
# Optional OpenAI-compatible vision OCR. Leave blank for honest manual input.
# Base URL includes /v1; HTTPS only. No customer images are sent when unconfigured.
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
