{
  "name": "taikang-admin-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests vite.config.js index.html package.json",
    "format:check": "prettier --check src tests vite.config.js index.html package.json"
  },
  "dependencies": {
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "prettier": "3.6.2",
    "vite": "6.4.1"
  }
}
